# Copy this file to .env on the server and replace the placeholder.
LAYA_ADMIN_KEY=replace_with_a_long_random_value

# Lifetime of newly created client keys, in days. Use "none" to never expire.
LAYA_KEY_TTL_DAYS=90

# Rate limits (requests per window, default window 60s) per client IP.
LAYA_RATE_LIMIT_ADMIN=10
LAYA_RATE_LIMIT_PREDICT=120
# LAYA_RATE_LIMIT_WINDOW=60

# Audit log level. Logs are written to stdout (captured by Docker).
# LAYA_LOG_LEVEL=INFO